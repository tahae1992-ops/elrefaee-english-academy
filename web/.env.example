# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's gitignored.
#
# Dev environment: Supabase project "elrefaee-academy-dev"
# (ref: pgepcmtqxlsezyzzwjrm, eu-west-3) — created in Sprint 1,
# dedicated to this app (kept separate from any other project in the
# same org). The DB password below is NOT retrievable via the API —
# get it from Project Settings > Database in the Supabase dashboard, or
# reset it there if it's been lost.
DATABASE_URL="postgresql://postgres:[YOUR-PASSWORD]@db.pgepcmtqxlsezyzzwjrm.supabase.co:5432/postgres"

# Publishable — not secret, safe to expose client-side (protected by
# RLS, not by secrecy). Used by Supabase Auth from Sprint 2 onward.
NEXT_PUBLIC_SUPABASE_URL="https://pgepcmtqxlsezyzzwjrm.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="sb_publishable_KjuLw7YQ_Cj4VsNBzNXdNQ_mrht8kkH"

# Sentry (Sprint 1's logging/monitoring task). Leaving these empty is
# safe — instrumentation.ts/instrumentation-client.ts no-op without a
# DSN, so local dev works fine unconfigured.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Only needed in CI for uploading source maps on release builds — never
# required for local development.
SENTRY_AUTH_TOKEN=""
