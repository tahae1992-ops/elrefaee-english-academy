# Copy this file to .env.local and fill in real values. Never commit
# .env.local — it's gitignored.
#
# Dev environment: your own Supabase project, dedicated to this app
# (kept separate from any other project in the same org). The DB
# password is NOT retrievable via the API — get it from Project
# Settings > Database in the Supabase dashboard, or reset it there if
# it's been lost.
#
# Transaction pooler (IPv4, port 6543), not the direct connection and
# not the session pooler (5432): the direct host (db.[ref].supabase.co)
# is IPv6-only on most project tiers and can fail DNS resolution in
# local dev; the session pooler pins one backend connection per client
# for the connection's lifetime and this project's pool_size is capped
# at 15 total -- fine for a single long-lived process, but Vercel's
# serverless functions each hold their own connection, so session mode
# exhausts the cap under any real concurrency (EMAXCONNSESSION). The
# transaction pooler multiplexes many short-lived callers over a much
# larger effective capacity, which is what a serverless deployment
# needs. URL-encode special characters in the password (e.g. @ -> %40).
DATABASE_URL="postgresql://postgres.[YOUR-PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[YOUR-REGION].pooler.supabase.com:6543/postgres"

# Publishable — not secret, safe to expose client-side (protected by
# RLS, not by secrecy). Used by Supabase Auth from Sprint 2 onward.
NEXT_PUBLIC_SUPABASE_URL="https://[YOUR-PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="[YOUR-SUPABASE-PUBLISHABLE-KEY]"

# Sentry (Sprint 1's logging/monitoring task). Leaving these empty is
# safe — instrumentation.ts/instrumentation-client.ts no-op without a
# DSN, so local dev works fine unconfigured.
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_ORG=""
SENTRY_PROJECT=""
# Only needed in CI for uploading source maps on release builds — never
# required for local development.
SENTRY_AUTH_TOKEN=""

# AI Tutor slice (SAD §7's AI Gateway, FR-12). Get a key from
# https://console.anthropic.com/settings/keys. Without this set, the
# AnthropicTutorAdapter throws on every call and the AI Gateway's
# fallback logic (no secondary adapter configured yet) surfaces the
# documented "tutor unavailable, try again shortly" state (SRS FR-12's
# Exception Flow) — the rest of the app runs fine unconfigured, same as
# the Sentry vars above.
ANTHROPIC_API_KEY=""
